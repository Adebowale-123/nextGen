# Copy to .env and fill in. Never commit .env.

DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# PostgreSQL (leave unset to fall back to SQLite for local tinkering)
# DATABASE_URL=postgres://nextgen:your-password@localhost:5432/nextgen

# Separate keys for signing tickets / sandbox webhooks (default: derived from SECRET_KEY)
# TICKET_SIGNING_KEY=
# MOCK_GATEWAY_SECRET=

# --- Payments: any of mock, paystack, flutterwave (comma-separated) ---
PAYMENT_PROVIDERS=mock
PAYOUT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- SMS (OTP + alerts): console | termii ---
SMS_BACKEND=console
TERMII_API_KEY=
TERMII_SENDER_ID=NextGen
# TERMII_BASE_URL=https://v3.api.termii.com   # use the base URL shown in your Termii dashboard

# --- Email (console backend prints emails to the terminal) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# --- KYC: mock | dojah ---
KYC_PROVIDER=mock
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# DOJAH_BASE_URL=https://api.dojah.io   # live; default is the sandbox

# --- Google OAuth 2.0 sign-in (optional) ---
# Redirect URI to register in Google Cloud: {SITE_URL}/accounts/oauth/google/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Platform rules (amounts in kobo; defaults shown) ---
# AML_WAGER_MULTIPLIER=1.0
# MIN_DEPOSIT=10000
# TIER1_DAILY_DEPOSIT_LIMIT=5000000
# DEFAULT_DAILY_DEPOSIT_LIMIT=50000000
# TIER1_MAX_STAKE_PER_PURCHASE=200000
# MIN_WITHDRAWAL=100000
# WITHDRAWAL_REVIEW_THRESHOLD=50000000
# MAX_WITHDRAWALS_PER_DAY=3
